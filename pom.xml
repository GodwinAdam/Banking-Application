<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        This <parent> tag inherits Spring Boot's "starter parent" POM.
        It gives us:
          - Sensible default plugin versions (compiler, surefire, jar, etc.)
          - A dependency-management section that pins compatible versions
            of every Spring Boot / Spring dependency, so we don't have to
            write <version> tags for spring-boot-starter-* below.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- Coordinates that uniquely identify this project in the Maven world -->
    <groupId>com.bankingapp</groupId>
    <artifactId>banking-application</artifactId>
    <version>1.0.0</version>
    <name>banking-application</name>
    <description>Learning project: Spring Boot Banking REST API with JPA and H2/MySQL/PostgreSQL</description>

    <properties>
        <!-- Compile and run the code against Java 25 (LTS) -->
        <java.version>25</java.version>
        <!-- Version of the Swagger / OpenAPI documentation library -->
        <springdoc.version>2.9.1</springdoc.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <dependencies>
        <!--
            spring-boot-starter-web:
            Brings in an embedded Tomcat server + Spring MVC, so our
            @RestController classes can accept HTTP requests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa:
            Brings in Hibernate (the JPA implementation) + Spring Data JPA,
            which lets us define Repository interfaces without writing SQL.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-validation:
            Adds Hibernate Validator so annotations like @NotBlank, @Email,
            @Positive on our DTOs are actually enforced.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            H2 Database:
            A pure-Java, file-less (in-memory or file-based) database.
            Used as our "local DB" so anyone can run this project with
            zero setup. Scope "runtime" = only needed when the app runs,
            not needed to compile our code.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            MySQL driver - included so you can switch to a real MySQL
            database later just by changing application.yml (see the
            "mysql" Spring profile and docs/DATABASE_SETUP.md).
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            PostgreSQL driver - same idea as MySQL above, for teams that
            prefer Postgres. Only one of these drivers will actually be
            used at runtime, based on the active profile's JDBC URL.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            springdoc-openapi:
            Auto-generates an interactive Swagger UI (http://localhost:8080/swagger-ui.html)
            from our @RestController classes, so you can call every API
            from the browser without Postman.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            spring-boot-starter-test:
            Bundles JUnit 5, Mockito, AssertJ and Spring's MockMvc test
            helpers. Scope "test" = only present on the test classpath.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin:
                Lets us run `mvn spring-boot:run` and also repackages the
                compiled classes into a single executable "fat JAR"
                (java -jar target/banking-application-1.0.0.jar).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
